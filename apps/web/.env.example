# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Nothing here is a secret today. It is here because two of these variables
# decide what the app is allowed to do, and a setting that changes authority
# should be written down rather than discovered by reading a route handler.

# --- Where the ops API lives ------------------------------------------------
# The Python backend, agri_edge.ops.api.
# The proxy at /api/ops/[...path] forwards to ${OPS_API_URL}/api/ops/...
#
# UNSET (the Vercel default): /ops runs in DEMO / SIMULATED mode -- deterministic
# synthetic sample data from src/lib/ops-demo.ts, under a "DEMO MODE" banner.
# Never point this at localhost on a hosted deployment.
# For local development against the Python backend:
#   OPS_API_URL=http://127.0.0.1:8765
OPS_API_URL=

# 1: serve demo data even if OPS_API_URL is set.
# 0: strict -- if OPS_API_URL is set but unreachable, answer 503 instead of
#    falling back to flagged demo data (reads only; writes are never faked).
OPS_DEMO=

# --- Whether the proxy may forward writes -----------------------------------
# Unset or anything but "1"/"true": the proxy forwards READS only. A POST to an
# allowlisted mutating route returns 403 with `writes_disabled`, and one to an
# unrecognised route returns 403 with `write_not_allowlisted`. Fail closed.
#
# Set to 1 and the allowlisted writes go through -- including
# POST /api/ops/vra/approve, which authorises a variable-rate prescription.
#
# THIS IS NOT AUTHENTICATION. There is no session, no role and no middleware in
# this app. Turning it on makes the approval gate reachable by anyone who can
# reach the server. Put real authentication in front of it first; roles belong
# upstream in the ops API, next to the audit log that records who approved what.
#
# Paths that look like vehicle commands (arm, takeoff, land, set_mode, mavlink,
# servo, spray, pump, valve) are refused on every method and this variable
# cannot enable them. See src/lib/ops-proxy-policy.ts.
OPS_ALLOW_WRITES=

# --- Optional ---------------------------------------------------------------
# Public base URL, if the app is served from somewhere other than localhost.
# NEXT_PUBLIC_SITE_URL=

# Public contact address for the "Contact us" buttons (mailto:). Unset = the
# buttons show a labelled "Contact email to be confirmed" placeholder. No address
# is committed to this repo. Set it in Vercel's environment variables and redeploy.
# NEXT_PUBLIC_CONTACT_EMAIL=
