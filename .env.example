# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Every secret this project uses is read from the environment, never from a
# config file, because config files are committed and secrets are not. The code
# reads these directly with os.environ -- nothing loads this file automatically,
# so export them, or use `set -a; . ./.env; set +a`, or your shell's dotenv.
#
# A missing variable is reported by name at startup rather than producing an
# authentication failure ten minutes later:
#   NtripConfig.missing()  ->  ["NTRIP_USERNAME", ...]
#   FarmOSClient          raises naming the variable it wanted

# --- farmOS -----------------------------------------------------------------
# JSON:API over OAuth2. src/agri_edge/store/farmos.py
FARMOS_USERNAME=
FARMOS_PASSWORD=
FARMOS_CLIENT_SECRET=

# --- RTK corrections --------------------------------------------------------
# NTRIP caster credentials. src/agri_edge/telemetry/ntrip.py
# The host, mountpoint and serial sink are ordinary config, not secrets, and
# live in config/*.yaml. Only these two are secret.
NTRIP_USERNAME=
NTRIP_PASSWORD=

# --- WebODM -----------------------------------------------------------------
# Self-hosted photogrammetry on the workstation. workstation/webodm_submit.py
WEBODM_USERNAME=
WEBODM_PASSWORD=

# --- MQTT -------------------------------------------------------------------
# Production MQTT must not be anonymous (spec section 48). The local
# ground_iot stack runs without auth for development only.
#
# A sensor must not hold credentials that can command an actuator. Give each
# device its own identity and topic ACL rather than sharing one login.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Ops database -----------------------------------------------------------
# PostgreSQL/PostGIS in production; SQLite needs no URL and is the default.
# e.g. postgresql://agri:CHANGEME@localhost:5432/agriedge
AGRIEDGE_DB_URL=
